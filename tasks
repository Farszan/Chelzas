#!/bin/bash

DOC="documents"
DIR="work"
GLYPH="$DIR/glyph"
FONT="$DIR/font"
BUILD="build"
ASCII="ascii.txt"
TEMP="temp.txt"
ERR="stderr.txt"

URL1="https://www.unicode.org/Public/18.0.0/ucd/UnicodeData.txt"
URL2="https://unicode.org/ivd/data/2026-08-03/IVD_Sequences.txt"
URL3="https://www.unicode.org/Public/18.0.0/ucd/StandardizedVariants.txt"

DATA1="UnicodeData.txt"
DATA2="IVD_Sequences.txt"
DATA3="ExtendedGlyphs.txt"
DATA4="StandardizedVariants.txt"

KEYWORDS="keywords.txt"
EXTENDED_GROUP="ExtendedGroupList.txt"

OUT3="use.txt"
OUT4="notuse.txt"
OUT5="codepoint.txt"

mkdir -p $DIR
mkdir -p $BUILD

rm -f $DIR/$ERR
echo "01:unicode.org からデータの取得"
if [ ! -e $DIR/$DATA1 ]; then
  wget -nv $URL1 -O $DIR/$DATA1 2>> $DIR/$ERR
fi
if [ ! -e $DIR/$DATA2 ]; then
  wget -nv $URL2 -O $DIR/$DATA2 2>> $DIR/$ERR
fi
if [ ! -e $DIR/$DATA4 ]; then
  wget -nv $URL3 -O $DIR/$DATA4 2>> $DIR/$ERR
fi

echo "02:拡張グループファイルの取得と結合"
rm -f $DIR/$DATA3
if [ -f "$EXTENDED_GROUP" ]; then
  grep -v '^\s*#' "$EXTENDED_GROUP" | sed '/^\s*$/d' | while read -r url; do
    if [ -n "$url" ]; then
      echo "  Downloading: $url"
      wget -qO- "$url" >> $DIR/$DATA3 2>> $DIR/$ERR
      echo "" >> $DIR/$DATA3
    fi
  done
fi

echo "03:収録コードポイントの生成"
rm -f $DIR/$TEMP
cat $KEYWORDS | while read LINE
do
  grep "$LINE" $DIR/$DATA1 | grep -v FILLER | grep -v SPACE >> $DIR/$TEMP
done
sort $DIR/$TEMP | uniq > $DIR/$OUT3
rm -f $DIR/$TEMP

echo "04:非収録コードポイントの生成"
grep -F -v -f $DIR/$OUT3 $DIR/$DATA1 > $DIR/$OUT4

echo "05:コードポイントリスト(UCS)の生成"
rm -f $DIR/$OUT5
python3 makecodepoint.py $DIR/$OUT3 $DIR/$OUT5

echo "06:コードポイントリスト(SVS)の生成"
rm -f $DIR/$TEMP
cat $KEYWORDS | while read LINE
do
  grep "$LINE" $DIR/$DATA4 >> $DIR/$TEMP
done
if [ -s $DIR/$TEMP ]; then
  grep -v -e "^#" $DIR/$TEMP | awk -F';' '{split($1, a, " "); if(a[1] && a[2]) printf "u%s-u%s\n",tolower(a[1]),tolower(a[2])}' >> $DIR/$OUT5
fi
rm -f $DIR/$TEMP

echo "07:コードポイントリスト(IVS)の生成"
grep -v -e "^#" $DIR/$DATA2 | awk -F'[; ]' '{printf "u%s-u%s\n",tolower($1),tolower($2)}' > $DIR/$TEMP
sort $DIR/$TEMP | uniq >> $DIR/$OUT5
rm -f $DIR/$TEMP

echo "08:追加コードポイントの取得（重複排除）"
if [ -f "$DIR/$DATA3" ]; then
  # 1列目を抽出し、コメント行・空行・CRを除去して一時ファイルへ出力
  awk -F';' '{print $1}' "$DIR/$DATA3" | grep -v '^\s*#' | sed 's/\r//g' | sed '/^\s*$/d' > $DIR/ext_temp.txt
  
  # 既に $OUT5 に存在するコードポイント（キーワード選定分）を除外して追記
  grep -v -F -x -f $DIR/$OUT5 $DIR/ext_temp.txt >> $DIR/$OUT5
  
  rm -f $DIR/ext_temp.txt
fi

echo "09:コードポイントリストにASCIIを追加"
cat $ASCII >> $DIR/$OUT5

echo "10:グリフSVGファイルの取得"
python3 getglyphs.py $GLYPH $DIR/$OUT5 $DIR/$DATA3

echo "11:グリフSVGファイルの確認"
rm -f $DIR/missing_glyphs.txt $DIR/excess_glyphs.txt
touch $DIR/expected_cp.txt

while IFS= read -r cp || [ -n "$cp" ]; do
    cp=$(echo "$cp" | tr -d '\r')
    if [ -n "$cp" ]; then
        echo "$cp" >> $DIR/expected_cp.txt
    fi
done < "$DIR/$OUT5"

matched=0
missing=0
excess=0

# 不足・一致の判定
while IFS= read -r cp || [ -n "$cp" ]; do
    base_cp="${cp%%-*}"
    sub1="${base_cp%???}"
    sub2="${base_cp%??}"
    svg_path="$GLYPH/${sub1}/${sub2}/${cp}.svg"

    if [ -f "$svg_path" ]; then
        matched=$((matched + 1))
    else
        echo "$cp" >> $DIR/missing_glyphs.txt
        missing=$((missing + 1))
    fi
done < $DIR/expected_cp.txt

# 過剰の判定（サブディレクトリ内を再帰的に走査）
while IFS= read -r f; do
    if [ -f "$f" ]; then
        filename=$(basename "$f" .svg)
        if ! grep -Fxq "$filename" $DIR/expected_cp.txt; then
            echo "$filename" >> $DIR/excess_glyphs.txt
            excess=$((excess + 1))
        fi
    fi
done < <(find "$GLYPH" -name "*.svg")

rm -f $DIR/expected_cp.txt

echo "  一致ファイル数: $matched"
echo "  不足ファイル数: $missing"
echo "  過剰ファイル数: $excess"

if [ $missing -ne 0 ]; then
    echo "必要なグリフSVGファイルが不足しています。終了します。"
    exit 1
fi

echo "12:フォント生成 #1"
perl makefont.pl

echo "13:フォント生成 #2"
perl makefont.pl 2

echo "14:フォント生成 #3"
perl makefont.pl 3

echo "15:フォント生成 #4"
perl makefont.pl f

echo "16:フォント生成 #5"
perl makefont.pl a

echo "17:グリフリストの生成"
perl glyphlist.pl > $BUILD/glyphlist.html

echo "18:ドキュメントと生成フォントの配置"
cp $DOC/* $BUILD/
cp $FONT/*.ttf $BUILD/